include README_EN.md CHANGELOG.md docs/usage-guide.md
prune evals
recursive-include aggregate_search/templates *.example *.example.json
prune .venv
prune .git
global-exclude .env .env.* .env~ keys.json keys.json.* keys.json~ *.db *.db-* *.sqlite *.sqlite-* *.sqlite3 *.sqlite3-* usage.jsonl* *.log *.log.* key-state.json* .key-state.json* usage-counters.json* *.migrated *.migrated.* *.tmp *.pyc
