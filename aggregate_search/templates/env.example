# aggregate-search 配置文件
#
# 用法：去掉行首的 #，把等号后面换成你自己的 key。改完后在 MCP 客户端里重连才生效。
# 一个 key 都不填也能用：Parallel / Keenable / AnySearch 匿名免费。
# 优先级：MCP 客户端传入的环境变量 > 本文件 > 同目录的 keys.json。
# 写错了不会让服务起不来：有问题的行会被跳过，并显示在 `aggregate-search status` 的最上面。
# 某一项留空（如 `SEARCH_PROXY=`）等于没写，会用默认值；名单类的配置想清空请写 none。

# ---------- 一、搜索厂商的 key（下面都是占位符，请替换） ----------
#
# 同一家想放多个 key：用带 S 的变量名，逗号分隔，会自动轮流使用、失效自动切换：
#   TAVILY_API_KEYS=tvly-your-first-key,tvly-your-second-key

# ---- 国际 ----
# TAVILY_API_KEY=tvly-your-key
# EXA_API_KEY=your-exa-key
# FIRECRAWL_API_KEY=fc-your-key
# JINA_API_KEY=jina_your-key
# QUERIT_API_KEY=your-querit-key
# OLLAMA_API_KEY=your-ollama-cloud-key
# BRAVE_API_KEY=BSA-your-key
# PERPLEXITY_API_KEY=pplx-your-key
# YDC_API_KEY=your-youcom-key

# ---- 国内 ----
# VOLCENGINE_API_KEY=your-volcengine-key
# BAIDU_API_KEY=your-baidu-qianfan-key
# TENCENTCLOUD_WSA_APIKEY=your-yuanbao-search-key
# ZHIPU_API_KEY=your-zhipu-key
# BOCHA_API_KEY=your-bocha-key

# ---- 匿名可用的三家（key 可选）----
# 不填 key 就能搜。填了 key 也默认不用它——只在这几种情况才带上：
# 匿名通道被限流（见下面的 ANON_KEY_FALLBACK）、你用 providers 点名指定、或 all 模式。
# PARALLEL_API_KEY=your-parallel-key
# KEENABLE_API_KEY=your-keenable-key
# ANYSEARCH_API_KEY=your-anysearch-key

# ---- 自建 SearXNG：不需要 key，填实例地址即启用（实例需开启 json 输出）----
# SEARXNG_BASE_URL=http://127.0.0.1:8080

# ---------- 二、省额度相关 ----------
# SEARCH_MODE=auto                 # 默认模式：auto / free / escalate / all
#                                  # 设成 free 后，搜索和抓取都只做匿名调用，绝不发送 key
# AUTO_ESCALATE_MAX=3              # auto 覆盖不足时自动补几家；0 = 不自动补，交给 Agent 用 escalate 决定
# ESCALATE_COUNT=3                 # escalate 每次补几家
# ANON_KEY_FALLBACK=true           # 匿名通道被限流时，配了该家 key 就改用 key；false = 严格匿名
# FREE_PROVIDERS=parallel,keenable,anysearch
# PAID_PROVIDERS=volcengine,querit,tavily,exa,firecrawl,jina,yuanbao,baidu,zhipu,bocha,brave,ollama,youcom,parallel,keenable,anysearch
#                                  # 通用补搜顺序。没写进来但配了 key 的厂商会自动排在最后
# ESCALATE_EXCLUDE=perplexity      # 不参与自动补搜的厂商（仍可点名使用）。Perplexity 每次是一次大模型调用，较贵
# UNVERIFIED_PROVIDERS=yuanbao,zhipu,bocha,brave,ollama,youcom,perplexity,searxng
#                                  # 未做真实调用验证的厂商：补搜时排到已实测厂商之后，并在 status 里标注（不禁用）
# ADAPTIVE_ROUTING=true            # 按近 7 天实际表现微调补搜顺序（只在本组内，不跨区、不剔除）
# ADAPTIVE_MIN_CALLS=5             # 至少这么多次真实调用才参与调权
# AUTO_MIN_RESULTS=4               # 门禁：最少证据条数
# AUTO_MIN_UNIQUE=3                # 门禁：最少相关独立页面数
# AUTO_MIN_CONSENSUS=1             # 门禁：复杂问题最少三源共识页面数；0 = 不要求

# 本地用量上限：每个 key 每天 / 每月最多发多少次请求，到量自动停用到下一天 / 下个月。
# 百度千帆超出每日免费额度后会按量计费，所以内置了 baidu:90；写 baidu:0 可取消。
# DAILY_LIMITS=baidu:90,tavily:30
# MONTHLY_LIMITS=tavily:900,exa:900

# ---------- 三、国内 / 国际补搜顺序（只影响先用哪几家，不过滤结果） ----------
# REGION_ROUTING=auto              # auto / off / cn / global
# DOMESTIC_PROVIDERS=baidu,volcengine,querit,yuanbao,zhipu,bocha
# GLOBAL_PROVIDERS=tavily,exa,firecrawl,jina

# ---------- 四、抓取 ----------
# 默认免费优先：parallel → keenable（都匿名）→ 配了 key 的后端。
# WEB_FETCH_PROVIDER=tavily        # 想固定先用某个后端就写在这里，可写多个：jina,tavily
# FETCH_MIN_CHARS=200              # 正文短于这个长度就换一家复核（只复核一次）；0 = 关闭
# FETCH_KEYED_FALLBACKS=2          # 免费后端都抓不到时，最多再试几个带 key 的后端
# FETCH_CACHE_TTL=300              # 同一网址在这段时间内重复抓取直接用缓存；0 = 不缓存
# FETCH_MAX_CHARS=20000            # 正文截断长度

# ---------- 五、网络 ----------
# SEARCH_PROXY=http://127.0.0.1:7897
# PROXY_PROVIDERS=jina,duckduckgo,youcom   # 哪几家走上面这个代理
# SEARCH_PROXY_ALL=false                    # true = 所有厂商都走上面这个代理
# USE_SYSTEM_PROXY=true                     # 其余厂商跟随系统的代理设置；false = 强制直连
# MCP_HTTP_TOKEN=                          # 只有用 --transport streamable-http 绑非回环地址时才需要，且必须 >=16 位
# SEARCH_TIMEOUT=15                         # 单家超时（秒）
# TOTAL_TIMEOUT=45                          # 一次搜索 / 抓取的总时限（秒），到点就带着已有结果返回

# ---------- 六、其它 ----------
# SEARCH_PROVIDERS=tavily,exa,parallel     # 限定 all 模式查哪几家
# MAX_RESULTS=5                            # 每家取几条
# MAX_RESULTS_CAP=20                       # 每家条数硬上限
# TOTAL_RESULTS=12                         # 最终返回多少个页面
# NEAR_DEDUP=true                          # 折叠高度相似的转载
# ENABLE_KEYLESS=false                     # true = Firecrawl 匿名、DuckDuckGo、You.com 也默认参与
# QUOTA_COOLDOWN=3600                      # key 额度耗尽后冷却多久（秒）
# RATE_COOLDOWN=60                         # key 或匿名通道被限流后冷却多久（秒）
# USAGE_LOG=true                           # false = 不写本地使用记录
# USAGE_LOG_MAX_MB=5                       # 使用记录超过这个大小就轮转
