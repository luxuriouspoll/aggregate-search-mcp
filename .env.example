# 复制为 .env 并填入真实 key；配了哪家的 key 就启用哪家的搜索。
# 真实 .env 已被 .gitignore 排除，不要提交密钥。
# 优先级：MCP 客户端 env > 本文件 > keys.json。

# ---- 多 key ----
# 复数变量支持多个 key，逗号 / 分号 / 换行分隔，同一家跨请求均衡轮转：
#   TAVILY_API_KEYS=tvly-your-first-key,tvly-your-second-key
# 单数变量兼容单个 key。

# ---- 搜索提供商（以下都只是占位符，请替换）----
# TAVILY_API_KEY=tvly-your-key
# VOLCENGINE_API_KEY=your-volcengine-key
# QUERIT_API_KEY=querit-your-key
# FIRECRAWL_API_KEY=fc-your-key
# OLLAMA_API_KEY=your-ollama-cloud-key
# BRAVE_API_KEY=BSA-your-key
# EXA_API_KEY=your-exa-key
# JINA_API_KEY=jina_your-key
# PARALLEL_API_KEY=your-parallel-key-optional
# PERPLEXITY_API_KEY=pplx-your-key
# SERPER_API_KEY=your-serper-key
# SERPAPI_API_KEY=your-serpapi-key
# LINKUP_API_KEY=your-linkup-key

# Parallel 不配 key 也能通过官方匿名 MCP 搜索，默认启用。
# SearXNG 不需要 key，填自建实例地址即启用（实例需允许 json 输出格式）
# SEARXNG_BASE_URL=http://127.0.0.1:8080

# ---- 可选项 ----
# SEARCH_PROVIDERS=tavily,exa,parallel  # 限定默认启用的搜索源子集
# WEB_FETCH_PROVIDER=tavily            # 首选抓取后端，失败自动尝试其他已启用后端
# MAX_RESULTS=5                        # 每家返回条数
# MAX_RESULTS_CAP=20                   # 单家条数硬上限
# SEARCH_TIMEOUT=15                    # 普通源超时秒数
# FETCH_MAX_CHARS=20000                # 抓取正文截断长度

# ---- 网络：默认只给指定源使用代理 ----
# SEARCH_PROXY=http://127.0.0.1:7897
# PROXY_PROVIDERS=jina,duckduckgo       # 哪些源走代理
# SEARCH_PROXY_ALL=false               # true 时所有源走代理

# Firecrawl 匿名、DuckDuckGo 是否默认参与；Parallel 匿名始终默认可用
# ENABLE_KEYLESS=false

# ---- key 限额状态 ----
# QUOTA_COOLDOWN=3600                  # 额度耗尽冷却秒数
# RATE_COOLDOWN=60                     # 限流冷却秒数
# KEY_STATE_FILE=.key-state.json       # 只保存 key 哈希与冷却状态
