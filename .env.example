# 复制为 .env 并填入真实 key；配了哪家的 key 就启用哪家的搜索。
# 也可以不建 .env，直接在 MCP 客户端注册配置里传同样的环境变量（客户端 env 优先级更高）。

# ---- 多 key ----
# 复数变量支持多个 key，逗号 / 分号 / 换行分隔，同一家会按顺序轮询：
#   TAVILY_API_KEYS=tvly-key1,tvly-key2,tvly-key3
# 单数变量（TAVILY_API_KEY）依然兼容，写一个 key 即可。
# 也可以把多 key 集中写在 keys.json（见 keys.example.json），环境变量优先于 keys.json。

# ---- 搜索提供商 ----
# TAVILY_API_KEY=tvly-xxxxxxxx
# VOLCENGINE_API_KEY=从 https://console.volcengine.com/search-infinity/api-key 取（也认 WEB_SEARCH_API_KEY）
# QUERIT_API_KEY=querit-xxxxxxxx
# FIRECRAWL_API_KEY=fc-xxxxxxxx
# OLLAMA_API_KEY=1234567890xxxxxxxx
# BRAVE_API_KEY=BSA-xxxxxxxx
# EXA_API_KEY=xxxxxxxx-xxxx-xxxx
# JINA_API_KEY=jina_xxxxxxxx
# PERPLEXITY_API_KEY=pplx-xxxxxxxx

# SearXNG 不需要 key，填自建实例地址即启用（实例需允许 json 输出格式）
# SEARXNG_BASE_URL=http://127.0.0.1:8080

# ---- 可选项（都有默认值，按需取消注释）----
# SEARCH_PROVIDERS=tavily,volcengine  # 限定默认启用的搜索商子集
# WEB_FETCH_PROVIDER=tavily           # 抓取后端: tavily | firecrawl | ollama | exa | jina
# MAX_RESULTS=5                       # 每家返回条数
# SEARCH_TIMEOUT=15                   # 单家超时（秒）
# FETCH_MAX_CHARS=20000               # 抓取正文截断长度

# ---- 网络 ----
# 境外免 key 源（DuckDuckGo）在国内直连超时，需要走代理时填这里
# SEARCH_PROXY=http://127.0.0.1:7897
# 免 key 源默认不参与聚合（避免超时拖慢搜索），设为 true 才自动启用
# ENABLE_KEYLESS=true

# ---- key 限额状态 ----
# MAX_RESULTS_CAP=20                  # 单家结果条数硬上限（防上游 400）
# QUOTA_COOLDOWN=3600                 # 额度耗尽冷却秒数（默认 1 小时）
# RATE_COOLDOWN=60                    # 限流冷却秒数（默认 1 分钟）
# KEY_STATE_FILE=.key-state.json      # 冷却状态落盘位置
